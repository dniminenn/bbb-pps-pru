[Unit]
Description=Discipline CPTS PHC from the GPS-driven system clock (TAI) for PTP agreement measurement
Documentation=https://github.com/dniminenn/bbs-pps-pru
After=chrony.service ptp4l.service
Wants=ptp4l.service

[Service]
# Reads CLOCK_REALTIME (GPS/PPS disciplined, the authority) and writes only the
# otherwise-idle CPTS PHC, in the TAI scale (-O 37) to match a PTP grandmaster.
# This never touches the system clock; it just makes /dev/ptp0 a faithful mirror
# of this box's GPS time so ptp4l (free_running, client to .24) can report the
# true clock-vs-clock agreement as its offsetFromMaster.
ExecStart=/usr/sbin/phc2sys -s CLOCK_REALTIME -c /dev/ptp0 -O 37 -m
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
